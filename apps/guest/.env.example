# The backend URL your phone calls. A phone can't reach "localhost" on your
# computer, so use your computer's Wi-Fi (LAN) IP. Find it:
#   macOS:   ipconfig getifaddr en0
#   Windows: ipconfig   (look for "IPv4 Address" under your Wi-Fi adapter)
# iOS Simulator can use http://localhost:4000
EXPO_PUBLIC_API_URL=http://192.168.1.5:4000 # this is example 
