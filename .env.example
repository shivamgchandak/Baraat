# ------------------------------------------------------------------
#  Baraat — environment template. Copy to .env and fill in.
#  This file is PUBLIC: keep placeholder values only, never real secrets.
# ------------------------------------------------------------------

# --- Database (Supabase Postgres, or any Postgres) ---
# Supabase -> Project Settings -> Database -> Connection string:
#   DATABASE_URL = "Transaction pooler" string  (host ...pooler.supabase.com, port 6543)
#   DIRECT_URL   = "Direct connection" string   (host db.<ref>.supabase.co,   port 5432)
# Replace <ref>/<region>/<password> with yours. Local Postgres: use the same URL for both.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"

# --- Auth ---
# Two DIFFERENT random secrets. Generate each (run twice):
#   macOS / Linux:        openssl rand -hex 32
#   Windows (PowerShell): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   (the node command also works on macOS/Linux if you don't have openssl)
JWT_SECRET="replace-with-a-random-64-char-hex-string"
JWT_REFRESH_SECRET="replace-with-a-DIFFERENT-random-64-char-hex-string"
ACCESS_TOKEN_TTL="3d"
REFRESH_TOKEN_TTL="30d"

# --- Maps ---
# Optional. Empty = free built-in offline estimator (no external calls, no cost).
# Real maps: Google Cloud Console -> enable Distance Matrix + Directions + Geocoding -> create API key.
GOOGLE_MAPS_API_KEY=""

# --- Services (constants; change only if a port clashes) ---
API_PORT=4000
DISPATCH_TICK_MS=5000

# --- Portal server ---
# Where the portal reaches the API. localhost in dev; your live API URL in production.
BACKEND_URL="http://localhost:4000"

# --- Email (optional; if unset, credential emails print to the console) ---
# Gmail: turn on 2-Step Verification, then create an App Password
#   (Google Account -> Security -> App passwords) and use that 16-char code as SMTP_PASS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-16-char-app-password"
MAIL_FROM="Baraat <no-reply@baraat.events>"

# --- Portal link put in the driver's welcome email ---
# Dev link used normally; prod link used when NODE_ENV=production. A single PORTAL_URL overrides both.
PORTAL_URL_DEV="http://localhost:3000"
PORTAL_URL_PROD="https://your-portal.vercel.app"
